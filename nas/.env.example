# ── GitHub OAuth App ─────────────────────────────
# 在 https://github.com/settings/developers → New OAuth App 创建
# Homepage URL: 填下面的 PUBLIC_URL
# Authorization callback URL: 下面的 PUBLIC_URL + /api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 会话签名密钥 ─────────────────────────────────
# 生成方式：openssl rand -hex 32
SESSION_SECRET=

# ── 对外访问地址 ─────────────────────────────────
# 必须与 GitHub OAuth App 里的回调地址同源，例如：
# https://nas.tailxxxx.ts.net
# （Tailscale 下执行 tailscale funnel status 可看到）
PUBLIC_URL=

# ── 登录白名单（建议填自己的 GitHub 用户名）────────
# 多个用逗号分隔；留空表示任何 GitHub 账号都能登录
ALLOWED_LOGIN=pecgi

# ── 会话有效期（天）──────────────────────────────
SESSION_DAYS=30

# ── 监听端口 ─────────────────────────────────────
PORT=8080
